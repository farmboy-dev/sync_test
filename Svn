#!/bin/bash

BASE_URL="https://example.com/files/"
DEPTH=2
OUTPUT_FILE="svn_repo_info.csv"

# CSV 헤더 추가
echo "Repo Name,Repo URL,Last Commit Author,Last Commit Date" > "$OUTPUT_FILE"

get_folders() {
    local url="$1"
    curl -sk "$url" | grep -oP '(?<=href=")[^"]+/' | while read -r folder; do
        local full_url="${url}${folder}"
        
        if [ "$2" -gt 1 ]; then
            check_svn_repo "$full_url" "$(( $2 - 1 ))"
        fi
    done
}

check_svn_repo() {
    local folder_url="$1"
    local depth="$2"

    curl -sk "$folder_url" | grep -oP '(?<=href=")[^"]+/' | while read -r subfolder; do
        local repo_url="${folder_url}${subfolder}"
        local repo_name=$(basename "$subfolder")  # SVN Repo 이름 추출

        # `.svn/` 존재 여부 체크
        if curl -sk --head "${repo_url}.svn/" | grep -q "200 OK"; then
            echo "SVN repo found: $repo_url"

            # `svn info` 실행
            svn_output=$(svn info "$repo_url" --non-interactive --trust-server-cert --no-auth-cache 2>/dev/null)
            author=$(echo "$svn_output" | awk -F': ' '/Last Changed Author/ {print $2}')
            date=$(echo "$svn_output" | awk -F': ' '/Last Changed Date/ {print $2}')

            # CSV 파일에 저장
            echo "\"$repo_name\",\"$repo_url\",\"$author\",\"$date\"" >> "$OUTPUT_FILE"
        fi

        # 재귀적으로 탐색
        if [ "$depth" -gt 1 ]; then
            check_svn_repo "$repo_url" "$(( $depth - 1 ))"
        fi
    done
}

# 실행
get_folders "$BASE_URL" "$DEPTH"
echo "CSV 저장 완료: $OUTPUT_FILE"


